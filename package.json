{
  "name": "chaos-button",
  "version": "1.0.0",
  "private": true,
  "description": "Chaos Button — an interactive experiment in poor decision making. One button. Do not press it.",
  "keywords": [
    "game",
    "interactive",
    "react",
    "vite",
    "typescript",
    "tailwindcss",
    "browser-game"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "^1.49.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "prettier": "^3.6.2",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-singlefile": "2.3.0",
    "vitest": "^5.0.3"
  }
}
